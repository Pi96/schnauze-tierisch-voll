---
import '../../styles/tokens.css';
import LexikonManifestClient from '../../components/LexikonManifestClient';
import { lexikonPaths } from '../../data/lexikon_paths';

// Pretty URLs: alle Pfade kommen aus dem Generator
export async function getStaticPaths() {
  return lexikonPaths; // slug als STRING (z.B. "Pferd/Erste-Hilfe")
}
---

<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Lexikon</title>
  </head>
  <body class="min-h-screen bg-white">
    <main class="max-w-6xl mx-auto p-4">
      <h1 class="text-3xl font-semibold mb-4">Lexikon</h1>
      <p class="text-neutral-600 mb-4">
        Wähle eine Kategorie oder öffne eine Datei. Du kannst auch direkt mit
        <code>/lexikon/&lt;Kategorie&gt;</code> verlinken.
      </p>

      <!-- Alles Dynamische übernimmt die Client-Komponente -->
      <LexikonManifestClient client:only="react" />
    </main>
  </body>
</html>
