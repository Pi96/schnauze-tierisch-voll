---
import '../../styles/tokens.css';
import MediaViewer from '../../components/MediaViewer.tsx';
import { lexikonPaths } from '../../data/lexikon_paths';

// 1) Statische Pfade an Astro liefern (Pretty URLs)
export async function getStaticPaths() {
  return lexikonPaths;
}

// 2) Aus params.slug den Ordnerpfad + Manifest laden
const slug = Astro.params.slug || []; // array
const currentPath = '/' + (Array.isArray(slug) ? slug.join('/') : '');
const manifest = await fetch('/lexikon_manifest.json').then(r=>r.json()).catch(()=>({items:[]}));
const all = manifest.items || [];
const here = all.filter((i:any)=> i.path === currentPath);
const dirs = all.filter((i:any)=> i.type==='dir' && i.path && i.path.startsWith(currentPath) && i.path.split('/').filter(Boolean).length === (currentPath.split('/').filter(Boolean).length+1));
const firstFile = here.find((i:any)=> i.type==='file') || null;
---

<html lang="de">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" />
<title>Lexikon – {currentPath || '/'}</title></head>
<body class="min-h-screen bg-white">
  <main class="max-w-6xl mx-auto p-4">
    <h1 class="text-2xl font-semibold mb-4">Lexikon: {currentPath || '/'}</h1>

    {firstFile && (
      <section class="mb-6">
        <MediaViewer client:only="react" item={{ name: firstFile.name, mime: firstFile.mime, url: firstFile.url }} />
      </section>
    )}

    <section class="mb-6">
      <h2 class="text-xl font-semibold mb-2">Unterordner</h2>
      {dirs.length === 0 ? <div class="text-neutral-500">Keine Unterordner.</div> :
        <ul class="grid md:grid-cols-2 gap-3">
          {dirs.map((d:any) => {
            const next = d.path.split('/').filter(Boolean);
            return <li><a class="block p-3 rounded-xl bg-neutral-50 hover:bg-neutral-100" href={`/lexikon/${next.join('/')}`}>📁 {d.path.split('/').pop()}</a></li>;
          })}
        </ul>
      }
    </section>

    <section>
      <h2 class="text-xl font-semibold mb-2">Dateien</h2>
      {here.filter((i:any)=>i.type==='file').length === 0 ? <div class="text-neutral-500">Keine Dateien.</div> :
        <ul class="grid md:grid-cols-2 gap-3">
          {here.filter((i:any)=>i.type==='file').map((f:any) => (
            <li>
              <a class="block p-3 rounded-xl bg-neutral-50 hover:bg-neutral-100" href={f.url} target={f.mime.startsWith('image/') ? '_self' : '_blank'}>📄 {f.name}</a>
            </li>
          ))}
        </ul>
      }
    </section>
  </main>
</body>
</html>
